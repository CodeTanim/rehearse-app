{
  "name": "rehearse-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:local": "node scripts/setup-local.mjs --seed --dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:fast": "npm run lint:strict && npm run typecheck && npm run test",
    "check": "npm run check:fast && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:local:setup": "node scripts/setup-local.mjs",
    "db:local:seed": "node scripts/setup-local.mjs --seed",
    "db:local:reset": "node scripts/setup-local.mjs --reset --seed",
    "db:local:studio": "node scripts/setup-local.mjs --studio",
    "demo:state": "node scripts/set-demo-state.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.12.0",
    "ai": "^7.0.93",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^5.4.54",
    "radix-ui": "1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jiti": "2.5.1",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "@tailwindcss/oxide@4.1.11": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@6.12.0": true,
    "unrs-resolver@1.11.1": true
  }
}
