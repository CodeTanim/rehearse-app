# `npm run dev:local` supplies isolated local values automatically.
# Copy this file to `.env` only when running the current SQLite prototype
# through the standard Prisma or Next.js commands.

DATABASE_URL="file:./dev.local.db"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_URL="http://localhost:3000"

# Keep `0` only for a trusted local full-app environment. Omit this variable or
# set it to `1` on Vercel until durable storage and production hardening land.
PORTFOLIO_DEMO="0"

# Replace DATABASE_URL with a PostgreSQL URL only after the Prisma datasource
# and migration baseline have been migrated to PostgreSQL.

# Password recovery remains disabled until a transactional email provider is configured.
EMAIL_FROM="Rehearse <noreply@example.com>"
RESEND_API_KEY=""

# Source-grounded quiz generation uses Vercel AI Gateway. Set a current
# provider/model id explicitly; local setup does not silently guess one.
AI_GATEWAY_MODEL=""
# AI_GATEWAY_API_KEY=""
# VERCEL_OIDC_TOKEN=""

# `npm run dev:local` supplies this automatically for a clearly labelled,
# deterministic product-flow preview. Never enable it in production.
REHEARSE_LOCAL_GENERATOR="0"
